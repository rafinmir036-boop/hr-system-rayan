<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>HR & Payroll Management System</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Font Awesome -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >

  <!-- Your CSS -->
  <link rel="stylesheet" href="css/style.css">
</head>

<body class="bg-gray-50">

<!-- ========================================================= -->
<!-- LOGIN PAGE -->
<!-- ========================================================= -->

<div
  id="login-page"
  class="min-h-screen bg-slate-950 flex items-center justify-center p-4"
>

  <div
    class="w-full max-w-md bg-white rounded-2xl shadow-2xl p-8"
  >

    <!-- Logo -->
    <div class="text-center mb-8">

      <div
        class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-2xl
        flex items-center justify-center mx-auto mb-4"
      >
        <i class="fa-solid fa-building-user text-3xl"></i>
      </div>

      <h1 class="text-2xl font-bold text-slate-800">
        HR Portal Login
      </h1>

      <p class="text-sm text-gray-500 mt-2">
        আপনার ইউজারনেম এবং পাসওয়ার্ড দিন
      </p>

    </div>


    <!-- LOGIN FORM -->

    <form id="login-form" class="space-y-5">

      <!-- Email -->

      <div>

        <label
          class="block text-sm font-medium text-slate-700 mb-2"
        >
          Username / Email
        </label>

        <div class="relative">

          <i
            class="fa-solid fa-envelope absolute left-4 top-1/2
            -translate-y-1/2 text-gray-400"
          ></i>

          <input
            id="login-email"
            type="email"
            required
            autocomplete="username"
            placeholder="Enter email"
            class="w-full pl-11 pr-4 py-3 border border-gray-200
            rounded-lg outline-none focus:ring-2
            focus:ring-indigo-500"
          >

        </div>

      </div>


      <!-- Password -->

      <div>

        <label
          class="block text-sm font-medium text-slate-700 mb-2"
        >
          Password
        </label>

        <div class="relative">

          <i
            class="fa-solid fa-lock absolute left-4 top-1/2
            -translate-y-1/2 text-gray-400"
          ></i>

          <input
            id="login-password"
            type="password"
            required
            autocomplete="current-password"
            placeholder="Enter password"
            class="w-full pl-11 pr-4 py-3 border border-gray-200
            rounded-lg outline-none focus:ring-2
            focus:ring-indigo-500"
          >

        </div>

      </div>


      <!-- Error -->

      <div
        id="login-error"
        class="text-sm text-red-600 text-center min-h-[20px]"
      ></div>


      <!-- Login Button -->

      <button
        id="login-button"
        type="submit"
        class="w-full bg-indigo-600 hover:bg-indigo-700
        text-white font-semibold py-3 rounded-lg
        transition"
      >
        Login
      </button>

    </form>

  </div>

</div>


<!-- ========================================================= -->
<!-- APPLICATION -->
<!-- ========================================================= -->

<div
  id="app-page"
  class="hidden h-screen flex overflow-hidden"
>


  <!-- ======================================================= -->
  <!-- SIDEBAR -->
  <!-- ======================================================= -->

  <aside
    class="w-64 bg-slate-900 text-slate-300
    flex flex-col flex-shrink-0"
  >

    <!-- Logo -->

    <div
      class="p-5 border-b border-slate-800
      flex items-center gap-3"
    >

      <i
        class="fa-solid fa-building-user
        text-indigo-400 text-2xl"
      ></i>

      <span
        class="font-bold text-lg text-white"
      >
        HR & Payroll
      </span>

    </div>


    <!-- Navigation -->

    <nav
      class="flex-1 overflow-y-auto p-4 space-y-1 text-sm"
      id="sidebar-menu"
    >

      <a
        href="#"
        onclick="switchTab('dashboard'); return false;"
        class="nav-item active flex items-center gap-3
        px-3 py-2.5 rounded-lg hover:bg-slate-800 transition"
      >
        <i class="fa-solid fa-chart-pie w-5"></i>
        Dashboard
      </a>


      <a
        href="#"
        onclick="switchTab('employees'); return false;"
        class="nav-item flex items-center gap-3
        px-3 py-2.5 rounded-lg hover:bg-slate-800 transition"
      >
        <i class="fa-solid fa-users w-5"></i>
        Employees
      </a>


      <a
        href="#"
        onclick="switchTab('attendance'); return false;"
        class="nav-item flex items-center gap-3
        px-3 py-2.5 rounded-lg hover:bg-slate-800 transition"
      >
        <i class="fa-solid fa-clock w-5"></i>
        Attendance
      </a>


      <a
        href="#"
        onclick="switchTab('leave'); return false;"
        class="nav-item flex items-center gap-3
        px-3 py-2.5 rounded-lg hover:bg-slate-800 transition"
      >
        <i class="fa-solid fa-calendar-minus w-5"></i>
        Leave
      </a>


      <a
        href="#"
        onclick="switchTab('payroll'); return false;"
        class="nav-item flex items-center gap-3
        px-3 py-2.5 rounded-lg hover:bg-slate-800 transition"
      >
        <i class="fa-solid fa-wallet w-5"></i>
        Payroll
      </a>


      <a
        href="#"
        onclick="switchTab('increments'); return false;"
        class="nav-item flex items-center gap-3
        px-3 py-2.5 rounded-lg hover:bg-slate-800 transition"
      >
        <i class="fa-solid fa-chart-line w-5"></i>
        Increment Due
      </a>

    </nav>


    <!-- Logout -->

    <div class="p-4 border-t border-slate-800">

      <button
        onclick="logout()"
        class="w-full flex items-center gap-3
        px-3 py-2 rounded-lg text-red-400
        hover:bg-slate-800 transition text-sm"
      >

        <i class="fa-solid fa-right-from-bracket w-5"></i>

        Logout

      </button>

    </div>

  </aside>


  <!-- ======================================================= -->
  <!-- MAIN -->
  <!-- ======================================================= -->

  <main
    class="flex-1 flex flex-col min-w-0
    overflow-hidden bg-gray-50"
  >


    <!-- TOP HEADER -->

    <header
      class="bg-white border-b px-6 py-4
      flex justify-between items-center"
    >

      <h1
        id="page-title"
        class="text-xl font-bold text-gray-800"
      >
        Dashboard
      </h1>


      <div class="flex items-center gap-3">

        <div class="text-right">

          <p
            id="user-display-name"
            class="text-sm font-semibold text-gray-800"
          >
            User
          </p>

          <p
            id="user-display-role"
            class="text-xs text-gray-500"
          >
            Administrator
          </p>

        </div>


        <div
          class="w-10 h-10 rounded-full
          bg-indigo-100 text-indigo-600
          flex items-center justify-center font-bold"
        >

          <i class="fa-solid fa-user"></i>

        </div>

      </div>

    </header>


    <!-- ===================================================== -->
    <!-- CONTENT -->
    <!-- ===================================================== -->

    <section
      class="flex-1 overflow-y-auto p-6"
    >


      <!-- =================================================== -->
      <!-- DASHBOARD -->
      <!-- =================================================== -->

      <div
        id="view-dashboard"
        class="tab-content"
      >

        <div
          class="grid grid-cols-1 md:grid-cols-2
          lg:grid-cols-4 gap-5 mb-6"
        >


          <!-- Employees -->

          <div
            class="bg-white p-5 rounded-xl
            border border-gray-100 shadow-sm"
          >

            <div class="flex justify-between">

              <p
                class="text-xs font-semibold
                text-gray-400 uppercase"
              >
                Total Employees
              </p>

              <i
                class="fa-solid fa-users
                text-indigo-500"
              ></i>

            </div>

            <h3
              id="stat-total-emp"
              class="text-2xl font-bold
              text-gray-800 mt-2"
            >
              0
            </h3>

          </div>


          <!-- Present -->

          <div
            class="bg-white p-5 rounded-xl
            border border-gray-100 shadow-sm"
          >

            <div class="flex justify-between">

              <p
                class="text-xs font-semibold
                text-emerald-500 uppercase"
              >
                Present Today
              </p>

              <i
                class="fa-solid fa-user-check
                text-emerald-500"
              ></i>

            </div>

            <h3
              id="stat-present"
              class="text-2xl font-bold
              text-emerald-600 mt-2"
            >
              0
            </h3>

          </div>


          <!-- Leave -->

          <div
            class="bg-white p-5 rounded-xl
            border border-gray-100 shadow-sm"
          >

            <div class="flex justify-between">

              <p
                class="text-xs font-semibold
                text-amber-500 uppercase"
              >
                On Leave
              </p>

              <i
                class="fa-solid fa-calendar-minus
                text-amber-500"
              ></i>

            </div>

            <h3
              id="stat-leave"
              class="text-2xl font-bold
              text-amber-600 mt-2"
            >
              0
            </h3>

          </div>


          <!-- Increment -->

          <div
            class="bg-white p-5 rounded-xl
            border border-gray-100 shadow-sm"
          >

            <div class="flex justify-between">

              <p
                class="text-xs font-semibold
                text-rose-500 uppercase"
              >
                Increment Due
              </p>

              <i
                class="fa-solid fa-chart-line
                text-rose-500"
              ></i>

            </div>

            <h3
              id="stat-increment-due"
              class="text-2xl font-bold
              text-rose-600 mt-2"
            >
              0
            </h3>

          </div>

        </div>


        <!-- Welcome -->

        <div
          class="bg-white rounded-xl border
          shadow-sm p-6"
        >

          <h2
            class="text-lg font-bold
            text-gray-800 mb-2"
          >
            Welcome to HR & Payroll Management System
          </h2>

          <p class="text-sm text-gray-500">
            এখানে আপনার Employee, Attendance,
            Leave, Payroll এবং Increment information
            manage করতে পারবেন।
          </p>

        </div>

      </div>


      <!-- =================================================== -->
      <!-- EMPLOYEES -->
      <!-- =================================================== -->

      <div
        id="view-employees"
        class="tab-content hidden"
      >

        <div
          class="bg-white rounded-xl
          border shadow-sm p-4"
        >

          <div
            class="flex justify-between
            items-center mb-4"
          >

            <h2
              class="text-lg font-bold text-gray-800"
            >
              Employee List
            </h2>

            <button
              onclick="openAddEmployee()"
              class="bg-indigo-600 text-white
              text-sm px-4 py-2 rounded-lg
              hover:bg-indigo-700"
            >
              + Add Employee
            </button>

          </div>


          <div class="overflow-x-auto">

            <table
              class="w-full text-left
              border-collapse text-sm"
            >

              <thead>

                <tr
                  class="bg-gray-50 border-b
                  text-gray-600"
                >

                  <th class="p-3">ID</th>
                  <th class="p-3">Name</th>
                  <th class="p-3">Branch</th>
                  <th class="p-3">Department</th>
                  <th class="p-3">Designation</th>
                  <th class="p-3">Status</th>

                </tr>

              </thead>

              <tbody id="employee-table-body">

              </tbody>

            </table>

          </div>

        </div>

      </div>


      <!-- =================================================== -->
      <!-- ATTENDANCE -->
      <!-- =================================================== -->

      <div
        id="view-attendance"
        class="tab-content hidden"
      >

        <div
          class="bg-white rounded-xl
          border shadow-sm p-4"
        >

          <h2
            class="text-lg font-bold
            text-gray-800 mb-4"
          >
            Attendance
          </h2>

          <div class="overflow-x-auto">

            <table
              class="w-full text-left
              border-collapse text-sm"
            >

              <thead>

                <tr
                  class="bg-gray-50
                  border-b text-gray-600"
                >

                  <th class="p-3">Employee ID</th>
                  <th class="p-3">Name</th>
                  <th class="p-3">Date</th>
                  <th class="p-3">Check In</th>
                  <th class="p-3">Check Out</th>
                  <th class="p-3">Status</th>

                </tr>

              </thead>

              <tbody id="attendance-table-body">

              </tbody>

            </table>

          </div>

        </div>

      </div>


      <!-- =================================================== -->
      <!-- LEAVE -->
      <!-- =================================================== -->

      <div
        id="view-leave"
        class="tab-content hidden"
      >

        <div
          class="bg-white rounded-xl
          border shadow-sm p-4"
        >

          <h2
            class="text-lg font-bold
            text-gray-800 mb-4"
          >
            Leave Management
          </h2>

          <div class="overflow-x-auto">

            <table
              class="w-full text-left
              border-collapse text-sm"
            >

              <thead>

                <tr
                  class="bg-gray-50
                  border-b text-gray-600"
                >

                  <th class="p-3">Employee ID</th>
                  <th class="p-3">Name</th>
                  <th class="p-3">Leave Type</th>
                  <th class="p-3">Date</th>
                  <th class="p-3">Status</th>

                </tr>

              </thead>

              <tbody id="leave-table-body">

              </tbody>

            </table>

          </div>

        </div>

      </div>


      <!-- =================================================== -->
      <!-- PAYROLL -->
      <!-- =================================================== -->

      <div
        id="view-payroll"
        class="tab-content hidden"
      >

        <div
          class="bg-white rounded-xl
          border shadow-sm p-6"
        >

          <h2
            class="text-lg font-bold
            text-gray-800 mb-2"
          >
            Payroll
          </h2>

          <p class="text-sm text-gray-500">
            Payroll module will be connected with
            employee salary information.
          </p>

        </div>

      </div>


      <!-- =================================================== -->
      <!-- INCREMENT -->
      <!-- =================================================== -->

      <div
        id="view-increments"
        class="tab-content hidden"
      >

        <div
          class="bg-white rounded-xl
          border shadow-sm p-4"
        >

          <h2
            class="text-lg font-bold
            text-gray-800 mb-4"
          >
            Increment Due Summary (1+ Year)
          </h2>

          <div class="overflow-x-auto">

            <table
              class="w-full text-left
              border-collapse text-sm"
            >

              <thead>

                <tr
                  class="bg-gray-50
                  border-b text-gray-600"
                >

                  <th class="p-3">Emp ID</th>
                  <th class="p-3">Name</th>
                  <th class="p-3">Branch</th>
                  <th class="p-3">Last Increment</th>
                  <th class="p-3">Status</th>

                </tr>

              </thead>

              <tbody id="increment-table-body">

              </tbody>

            </table>

          </div>

        </div>

      </div>

    </section>

  </main>

</div>


<!-- ========================================================= -->
<!-- FIREBASE APPLICATION -->
<!-- ========================================================= -->

<script type="module" src="js/app.js"></script>

</body>
</html>
