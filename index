<!DOCTYPE html>

<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>HR & Payroll System</title>


  <!-- Tailwind CSS -->

  <script src="https://cdn.tailwindcss.com"></script>


  <!-- Font Awesome -->

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
  >


  <!-- Custom CSS -->

  <link
    rel="stylesheet"
    href="css/style.css"
  >

</head>


<body class="bg-gray-50">


<!-- =====================================================
     LOGIN PAGE
===================================================== -->

<div
  id="login-page"
  class="min-h-screen flex items-center justify-center bg-slate-900 p-6"
>

  <div
    class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-8"
  >

    <div class="text-center mb-8">

      <div
        class="
          w-16 h-16
          mx-auto
          rounded-2xl
          bg-indigo-100
          text-indigo-600
          flex
          items-center
          justify-center
          text-3xl
          mb-4
        "
      >

        <i class="fa-solid fa-building-user"></i>

      </div>


      <h1
        class="text-2xl font-bold text-gray-800"
      >

        HR & Payroll

      </h1>


      <p
        class="text-sm text-gray-500 mt-1"
      >

        Management System

      </p>

    </div>


    <form id="login-form">

      <!-- EMAIL -->

      <div class="mb-4">

        <label
          class="block text-sm font-medium text-gray-700 mb-2"
        >

          Email

        </label>

        <input
          id="login-email"
          type="email"
          required
          placeholder="admin@example.com"
          class="
            w-full
            border
            rounded-lg
            px-4
            py-3
            outline-none
            focus:ring-2
            focus:ring-indigo-500
          "
        >

      </div>


      <!-- PASSWORD -->

      <div class="mb-5">

        <label
          class="block text-sm font-medium text-gray-700 mb-2"
        >

          Password

        </label>

        <input
          id="login-password"
          type="password"
          required
          placeholder="••••••••"
          class="
            w-full
            border
            rounded-lg
            px-4
            py-3
            outline-none
            focus:ring-2
            focus:ring-indigo-500
          "
        >

      </div>


      <!-- ERROR -->

      <p
        id="login-error"
        class="text-red-500 text-sm mb-4"
      ></p>


      <!-- LOGIN BUTTON -->

      <button
        id="login-button"
        type="submit"
        class="
          w-full
          bg-indigo-600
          hover:bg-indigo-700
          text-white
          font-semibold
          py-3
          rounded-lg
          transition
        "
      >

        Login

      </button>

    </form>

  </div>

</div>



<!-- =====================================================
     APPLICATION
===================================================== -->

<div
  id="app-page"
  class="hidden h-screen flex overflow-hidden"
>


  <!-- ===================================================
       SIDEBAR
  ==================================================== -->

  <aside
    class="
      w-64
      bg-slate-900
      text-slate-300
      flex
      flex-col
      flex-shrink-0
    "
  >


    <!-- LOGO -->

    <div
      class="
        p-5
        border-b
        border-slate-800
        flex
        items-center
        gap-3
      "
    >

      <i
        class="
          fa-solid
          fa-building-user
          text-indigo-400
          text-2xl
        "
      ></i>


      <span
        class="font-bold text-lg text-white"
      >

        HR & Payroll

      </span>

    </div>


    <!-- MENU -->

    <nav
      class="
        flex-1
        overflow-y-auto
        p-4
        space-y-1
        text-sm
      "
      id="sidebar-menu"
    >


      <a
        href="#"
        onclick="switchTab('dashboard'); return false;"
        class="
          nav-item
          active
          flex
          items-center
          gap-3
          px-3
          py-2.5
          rounded-lg
          hover:bg-slate-800
          transition
        "
      >

        <i
          class="fa-solid fa-chart-pie w-5"
        ></i>

        Dashboard

      </a>


      <a
        href="#"
        onclick="switchTab('employees'); return false;"
        class="
          nav-item
          flex
          items-center
          gap-3
          px-3
          py-2.5
          rounded-lg
          hover:bg-slate-800
          transition
        "
      >

        <i
          class="fa-solid fa-users w-5"
        ></i>

        Employees

      </a>


      <a
        href="#"
        onclick="switchTab('attendance'); return false;"
        class="
          nav-item
          flex
          items-center
          gap-3
          px-3
          py-2.5
          rounded-lg
          hover:bg-slate-800
          transition
        "
      >

        <i
          class="fa-solid fa-clock w-5"
        ></i>

        Attendance

      </a>


      <a
        href="#"
        onclick="switchTab('leave'); return false;"
        class="
          nav-item
          flex
          items-center
          gap-3
          px-3
          py-2.5
          rounded-lg
          hover:bg-slate-800
          transition
        "
      >

        <i
          class="fa-solid fa-calendar-minus w-5"
        ></i>

        Leave

      </a>


      <a
        href="#"
        onclick="switchTab('payroll'); return false;"
        class="
          nav-item
          flex
          items-center
          gap-3
          px-3
          py-2.5
          rounded-lg
          hover:bg-slate-800
          transition
        "
      >

        <i
          class="fa-solid fa-wallet w-5"
        ></i>

        Payroll

      </a>


      <a
        href="#"
        onclick="switchTab('increments'); return false;"
        class="
          nav-item
          flex
          items-center
          gap-3
          px-3
          py-2.5
          rounded-lg
          hover:bg-slate-800
          transition
        "
      >

        <i
          class="fa-solid fa-chart-line w-5"
        ></i>

        Increment Due

      </a>

    </nav>


    <!-- LOGOUT -->

    <div
      class="p-4 border-t border-slate-800"
    >

      <button
        onclick="logout()"
        class="
          w-full
          flex
          items-center
          gap-3
          px-3
          py-2
          rounded-lg
          text-red-400
          hover:bg-slate-800
          transition
          text-sm
        "
      >

        <i
          class="fa-solid fa-right-from-bracket w-5"
        ></i>

        Logout

      </button>

    </div>

  </aside>



  <!-- ===================================================
       MAIN CONTENT
  ==================================================== -->

  <main
    class="
      flex-1
      flex
      flex-col
      min-w-0
      overflow-hidden
      bg-gray-50
    "
  >


    <!-- TOP HEADER -->

    <header
      class="
        bg-white
        border-b
        px-6
        py-4
        flex
        justify-between
        items-center
      "
    >

      <h1
        id="page-title"
        class="text-xl font-bold text-gray-800"
      >

        Dashboard

      </h1>


      <div
        class="flex items-center gap-3"
      >

        <div class="text-right">

          <p
            id="user-display-name"
            class="text-sm font-semibold text-gray-800"
          >

            User

          </p>

          <p
            id="user-display-role"
            class="text-xs text-gray-500"
          >

            Administrator

          </p>

        </div>


        <div
          class="
            w-10
            h-10
            rounded-full
            bg-indigo-100
            text-indigo-600
            flex
            items-center
            justify-center
            font-bold
          "
        >

          <i
            class="fa-solid fa-user"
          ></i>

        </div>

      </div>

    </header>



    <!-- =================================================
         DYNAMIC CONTENT
    ================================================== -->

    <section
      class="
        flex-1
        overflow-y-auto
        p-6
      "
    >


      <!-- ===============================================
           DASHBOARD
      ================================================ -->

      <div
        id="view-dashboard"
        class="tab-content"
      >

        <div
          class="
            grid
            grid-cols-1
            md:grid-cols-2
            xl:grid-cols-4
            gap-5
            mb-6
          "
        >


          <!-- TOTAL -->

          <div
            class="
              bg-white
              p-5
              rounded-xl
              border
              border-gray-100
              shadow-sm
            "
          >

            <p
              class="
                text-xs
                font-semibold
                text-gray-400
                uppercase
              "
            >

              Total Employees

            </p>

            <h3
              id="stat-total-emp"
              class="
                text-2xl
                font-bold
                text-gray-800
                mt-2
              "
            >

              0

            </h3>

          </div>


          <!-- PRESENT -->

          <div
            class="
              bg-white
              p-5
              rounded-xl
              border
              border-gray-100
              shadow-sm
            "
          >

            <p
              class="
                text-xs
                font-semibold
                text-emerald-500
                uppercase
              "
            >

              Present Today

            </p>

            <h3
              id="stat-present"
              class="
                text-2xl
                font-bold
                text-emerald-600
                mt-2
              "
            >

              0

            </h3>

          </div>


          <!-- LEAVE -->

          <div
            class="
              bg-white
              p-5
              rounded-xl
              border
              border-gray-100
              shadow-sm
            "
          >

            <p
              class="
                text-xs
                font-semibold
                text-amber-500
                uppercase
              "
            >

              On Leave

            </p>

            <h3
              id="stat-leave"
              class="
                text-2xl
                font-bold
                text-amber-600
                mt-2
              "
            >

              0

            </h3>

          </div>


          <!-- INCREMENT -->

          <div
            class="
              bg-white
              p-5
              rounded-xl
              border
              border-gray-100
              shadow-sm
            "
          >

            <p
              class="
                text-xs
                font-semibold
                text-rose-500
                uppercase
              "
            >

              Increment Due

            </p>

            <h3
              id="stat-increment-due"
              class="
                text-2xl
                font-bold
                text-rose-600
                mt-2
              "
            >

              0

            </h3>

          </div>

        </div>


        <!-- WELCOME -->

        <div
          class="
            bg-white
            rounded-xl
            border
            p-6
            shadow-sm
          "
        >

          <h2
            class="text-xl font-bold text-gray-800"
          >

            Welcome to HR & Payroll System

          </h2>


          <p
            class="text-gray-500 mt-2"
          >

            Firebase connected successfully.
            Your HR management dashboard is ready.

          </p>

        </div>

      </div>



      <!-- ===============================================
           EMPLOYEES
      ================================================ -->

      <div
        id="view-employees"
        class="tab-content hidden"
      >

        <div
          class="
            bg-white
            rounded-xl
            border
            shadow-sm
            p-4
          "
        >

          <div
            class="
              flex
              justify-between
              items-center
              mb-4
            "
          >

            <h2
              class="text-lg font-bold text-gray-800"
            >

              Employee List

            </h2>


            <button
              onclick="alert('Employee form will be added next.')"
              class="
                bg-indigo-600
                text-white
                text-sm
                px-4
                py-2
                rounded-lg
                hover:bg-indigo-700
              "
            >

              + Add Employee

            </button>

          </div>


          <div class="overflow-x-auto">

            <table
              class="
                w-full
                text-left
                border-collapse
                text-sm
              "
            >

              <thead>

                <tr
                  class="
                    bg-gray-50
                    border-b
                    text-gray-600
                  "
                >

                  <th class="p-3">ID</th>

                  <th class="p-3">Name</th>

                  <th class="p-3">Branch</th>

                  <th class="p-3">Department</th>

                  <th class="p-3">Designation</th>

                  <th class="p-3">Status</th>

                </tr>

              </thead>


              <tbody
                id="employee-table-body"
              >

              </tbody>

            </table>

          </div>

        </div>

      </div>



      <!-- ===============================================
           ATTENDANCE
      ================================================ -->

      <div
        id="view-attendance"
        class="tab-content hidden"
      >

        <div
          class="
            bg-white
            rounded-xl
            border
            shadow-sm
            p-4
          "
        >

          <h2
            class="
              text-lg
              font-bold
              text-gray-800
              mb-4
            "
          >

            Attendance

          </h2>


          <div class="overflow-x-auto">

            <table
              class="
                w-full
                text-left
                text-sm
              "
            >

              <thead>

                <tr
                  class="
                    bg-gray-50
                    border-b
                  "
                >

                  <th class="p-3">
                    Employee ID
                  </th>

                  <th class="p-3">
                    Name
                  </th>

                  <th class="p-3">
                    Date
                  </th>

                  <th class="p-3">
                    Check In
                  </th>

                  <th class="p-3">
                    Check Out
                  </th>

                  <th class="p-3">
                    Status
                  </th>

                </tr>

              </thead>


              <tbody
                id="attendance-table-body"
              >

              </tbody>

            </table>

          </div>

        </div>

      </div>



      <!-- ===============================================
           LEAVE
      ================================================ -->

      <div
        id="view-leave"
        class="tab-content hidden"
      >

        <div
          class="
            bg-white
            rounded-xl
            border
            shadow-sm
            p-4
          "
        >

          <h2
            class="
              text-lg
              font-bold
              text-gray-800
              mb-4
            "
          >

            Leave Management

          </h2>


          <div class="overflow-x-auto">

            <table
              class="
                w-full
                text-left
                text-sm
              "
            >

              <thead>

                <tr
                  class="
                    bg-gray-50
                    border-b
                  "
                >

                  <th class="p-3">
                    Employee ID
                  </th>

                  <th class="p-3">
                    Name
                  </th>

                  <th class="p-3">
                    Leave Type
                  </th>

                  <th class="p-3">
                    Date
                  </th>

                  <th class="p-3">
                    Status
                  </th>

                </tr>

              </thead>


              <tbody
                id="leave-table-body"
              >

              </tbody>

            </table>

          </div>

        </div>

      </div>



      <!-- ===============================================
           PAYROLL
      ================================================ -->

      <div
        id="view-payroll"
        class="tab-content hidden"
      >

        <div
          class="
            bg-white
            rounded-xl
            border
            shadow-sm
            p-6
          "
        >

          <h2
            class="
              text-lg
              font-bold
              text-gray-800
            "
          >

            Payroll

          </h2>


          <p
            class="
              text-gray-500
              mt-2
            "
          >

            Payroll module is ready
            for Firebase integration.

          </p>

        </div>

      </div>



      <!-- ===============================================
           INCREMENT
      ================================================ -->

      <div
        id="view-increments"
        class="tab-content hidden"
      >

        <div
          class="
            bg-white
            rounded-xl
            border
            shadow-sm
            p-4
          "
        >

          <h2
            class="
              text-lg
              font-bold
              text-gray-800
              mb-4
            "
          >

            Increment Due Summary (1+ Year)

          </h2>


          <div class="overflow-x-auto">

            <table
              class="
                w-full
                text-left
                border-collapse
                text-sm
              "
            >

              <thead>

                <tr
                  class="
                    bg-gray-50
                    border-b
                    text-gray-600
                  "
                >

                  <th class="p-3">
                    Emp ID
                  </th>

                  <th class="p-3">
                    Name
                  </th>

                  <th class="p-3">
                    Branch
                  </th>

                  <th class="p-3">
                    Last Increment
                  </th>

                  <th class="p-3">
                    Status
                  </th>

                </tr>

              </thead>


              <tbody
                id="increment-table-body"
              >

              </tbody>

            </table>

          </div>

        </div>

      </div>


    </section>

  </main>

</div>



<!-- =====================================================
     FIREBASE + APPLICATION
===================================================== -->

<script
  type="module"
  src="js/app.js"
></script>


</body>

</html>
