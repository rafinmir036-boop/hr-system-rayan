<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HR Portal Login</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 font-sans antialiased">

    <!-- LOGIN SCREEN -->
    <div id="login-screen" class="min-h-screen flex items-center justify-center bg-slate-900 px-4">
        <div class="bg-white p-8 rounded-xl shadow-lg w-full max-w-md text-center">
            <h2 class="text-2xl font-bold text-slate-800 mb-2">HR Portal Login</h2>
            <p class="text-slate-500 text-sm mb-6">আপনার ইউজারনেম এবং পাসওয়ার্ড দিন</p>
            
            <form id="login-form">
                <div class="mb-4 text-left">
                    <label class="block text-slate-700 text-sm font-semibold mb-2">Username / Employee ID</label>
                    <input type="email" id="email" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:border-indigo-500" placeholder="admin@test.com" required>
                </div>
                <div class="mb-6 text-left">
                    <label class="block text-slate-700 text-sm font-semibold mb-2">Password</label>
                    <input type="password" id="password" class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:border-indigo-500" placeholder="••••••••" required>
                </div>
                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-lg transition">লগইন করুন</button>
            </form>
        </div>
    </div>

    <!-- APP SCREEN (Hidden by default) -->
    <div id="app-screen" class="min-h-screen flex items-center justify-center bg-slate-900 text-white hidden">
        <div class="text-center p-8 bg-slate-800 rounded-xl max-w-md w-full shadow-2xl">
            <h1 class="text-3xl font-bold text-sky-400 mb-4">HR & Payroll Dashboard</h1>
            <p class="text-slate-300 mb-6">আপনি সফলভাবে লগইন করেছেন!</p>
            <button id="logout-btn" class="bg-red-500 hover:bg-red-600 text-white font-semibold px-6 py-2 rounded-lg transition">লগআউট</button>
        </div>
    </div>

    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>

    <!-- Embedded Application Logic -->
    <script>
        // Firebase Config (Your Exact API Keys Attached)
        const firebaseConfig = {
            apiKey: "AIzaSyB20hWCqKPSt2aZxVOYa3cz2FVX2MSCs1U",
            authDomain: "rafin-328ee.firebaseapp.com",
            projectId: "rafin-328ee",
            storageBucket: "rafin-328ee.firebasestorage.app",
            messagingSenderId: "393954293230",
            appId: "1:393954293230:web:03bb7b058a89c339410aff",
            measurementId: "G-0HN3Z0SJ3W"
        };

        if (!firebase.apps.length) {
            firebase.initializeApp(firebaseConfig);
        }

        const auth = firebase.auth();

        const loginForm = document.getElementById("login-form");
        const loginScreen = document.getElementById("login-screen");
        const appScreen = document.getElementById("app-screen");
        const logoutBtn = document.getElementById("logout-btn");

        loginForm.addEventListener("submit", (e) => {
            e.preventDefault(); // ব্রাউজার রিফ্রেশ হওয়া আটকানো

            const email = document.getElementById("email").value.trim();
            const password = document.getElementById("password").value.trim();

            auth.signInWithEmailAndPassword(email, password)
                .then(() => {
                    showApp();
                })
                .catch((error) => {
                    alert("লগইন ভুল হয়েছে: " + error.message);
                });
        });

        logoutBtn.addEventListener("click", () => {
            auth.signOut().then(() => showLogin());
        });

        auth.onAuthStateChanged((user) => {
            if (user) showApp();
            else showLogin();
        });

        function showApp() {
            loginScreen.classList.add("hidden");
            appScreen.classList.remove("hidden");
        }

        function showLogin() {
            loginScreen.classList.remove("hidden");
            appScreen.classList.add("hidden");
        }
    </script>
</body>
</html>
