<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HR Portal</title>
    <link rel="stylesheet" href="css/style.css">
    <style>
        /* বেসিক স্টাইল */
        body { font-family: Arial, sans-serif; background-color: #0d1117; color: #fff; margin: 0; padding: 0; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .card { background: #ffffff; color: #333; padding: 30px; border-radius: 12px; width: 350px; text-align: center; }
        .input-group { margin-bottom: 15px; text-align: left; }
        .input-group label { display: block; margin-bottom: 5px; font-size: 14px; }
        .input-group input { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; }
        .btn { width: 100%; padding: 12px; background: #4f46e5; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 16px; }
        .btn:hover { background: #4338ca; }
        #dashboard { display: none; text-align: center; background: #161b22; padding: 40px; border-radius: 12px; width: 80%; max-width: 600px; }
    </style>
</head>
<body>

    <!-- লগইন কার্ড -->
    <div class="card" id="login-card">
        <h2>HR Portal Login</h2>
        <p style="font-size: 13px; color: #666;">আপনার ইমেইল/ইউজারনেম এবং পাসওয়ার্ড দিন</p>
        
        <form id="login-form">
            <div class="input-group">
                <label>Username / Email</label>
                <input type="email" id="email" placeholder="example@domain.com" required>
            </div>
            <div class="input-group">
                <label>Password</label>
                <input type="password" id="password" placeholder="••••••••" required>
            </div>
            <button type="submit" class="btn">লগইন করুন</button>
        </form>
    </div>

    <!-- ড্যাশবোর্ড সেকশন (লগইনের পর এটি দেখাবে) -->
    <div id="dashboard">
        <h1>স্বাগতম HR ড্যাশবোর্ডে!</h1>
        <p>আপনি সফলভাবে লগইন করেছেন।</p>
        <button class="btn" id="logout-btn" style="width: auto; background: #dc2626; margin-top: 20px;">লগআউট</button>
    </div>

    <!-- Firebase SDKs (Compat v9/v10) -->
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore-compat.js"></script>

    <!-- Custom JavaScript Files -->
    <script src="firebase/config.js"></script>
    <script src="js/app.js"></script>
</body>
</html>
